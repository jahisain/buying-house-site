# ==========================================
# Environment Variables Configuration
# ==========================================

# 1. Search Engine Indexing
# Set to 'true' in production when ready to enable search engine indexing.
# Defaults to false (sets noindex, nofollow).
NEXT_PUBLIC_ALLOW_INDEXING=false

# 2. Cloudflare Turnstile (Spam Protection)
# Optional in development (skips gracefully if unset).
# Required in production for bot and spam protection on the RFQ form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 3. Resend Email Service
# Optional in development (logs form submissions to console if unset).
# Required in production to deliver confirmation and notification emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
